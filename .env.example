# ============================================================
#  Enterprise Brain — copy this file to .env and fill in
#      cp .env.example .env
#  .env is gitignored. This file is not: keep real keys out of it.
# ============================================================

# ---------- OpenAI: chat model + embeddings ----------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model. Used by the agent and by the ingestion extractor.
# gpt-4.1-mini is the sweet spot here: extraction is one call per chunk.
# Use gpt-4.1 if entity extraction quality matters more than cost.
CHAT_MODEL=gpt-4.1-mini

# Embeddings. text-embedding-3-small = 1536 dims, -large = 3072.
# EMBEDDING_DIM must match the model, and changing it means re-ingesting with reset=True.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Optional: only set these if embeddings should come from somewhere other than
# the OpenAI account above (Azure OpenAI, local TEI, Ollama at http://localhost:11434/v1).
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Neo4j (docker compose) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ---------- Qdrant (docker compose) ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=brain_chunks

# ---------- Ingestion ----------
RAW_DIR=./data/raw
CHUNK_CHARS=1600
CHUNK_OVERLAP=200
